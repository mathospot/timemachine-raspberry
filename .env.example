# Example environment variables for timemachine-raspberry
# Copy to .env and set real values. Do NOT commit .env with real passwords.

# Samba account
SAMBA_USER=timemachine
SAMBA_PASS=ChangeMeStrongPassword!

# Host path where the disk is mounted
HOST_MOUNT=/mnt/storage/timemachine

# Timezone
TZ=Europe/Madrid

# Samba image (you can change to a custom-built image if you need vfs_fruit)
SAMBA_IMAGE=dperson/samba:latest

# Avahi services folder on host (relative to repo root)
AVAHI_HOST_DIR=./avahi_services
